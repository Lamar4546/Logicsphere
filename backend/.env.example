# Backend environment example
SUPABASE_URL=
# Server-only service_role/secret key; do not use the anon or publishable key.
SUPABASE_SERVICE_KEY=
JWT_SECRET_KEY=dev-secret-change-me
# The public frontend origin used in Supabase password-recovery links.
FRONTEND_URL=http://localhost:5173
# Required by Nominatim's public usage policy; customize this for deployment.
MAP_LOOKUP_USER_AGENT=LogiSphere/1.0 (contact: ops@example.com)
# Hugging Face Inference Providers — keep this token server-only.
# Token needs the "Make calls to Inference Providers" permission.
HF_TOKEN=
HF_MODEL=openai/gpt-oss-120b:fastest
HF_API_URL=https://router.huggingface.co/v1/chat/completions
# Generic OpenAI-compatible provider override (optional).
AI_PROVIDER=huggingface
AI_API_KEY=
AI_MODEL=
AI_API_URL=
# Legacy MiniMax configuration is supported for existing deployments only.
MINIMAX_API_KEY=
MINIMAX_MODEL=MiniMax-M2.7
MINIMAX_API_URL=https://api.minimax.io/v1/chat/completions
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
# Twilio WhatsApp sandbox sender, e.g. +14155238886
TWILIO_WHATSAPP_FROM=
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
# Keep true while testing to prevent real delivery.
SENDGRID_SANDBOX_MODE=true
# Integration secrets are never stored in Supabase or sent to the browser.
# Create an integration connection with its matching auth_env_key, then set it here.
CARRIER_API_TOKEN=
ERP_API_TOKEN=
WMS_API_TOKEN=
