# Backend environment example
SUPABASE_URL=
# Server-only service_role/secret key; do not use the anon or publishable key.
SUPABASE_SERVICE_KEY=
JWT_SECRET_KEY=dev-secret-change-me
MINIMAX_API_KEY=
MINIMAX_MODEL=MiniMax-M3
# Optional; defaults to https://api.minimax.io/v1/chat/completions
MINIMAX_API_URL=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
# Twilio WhatsApp sandbox sender, e.g. +14155238886
TWILIO_WHATSAPP_FROM=
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
# Keep true while testing to prevent real delivery.
SENDGRID_SANDBOX_MODE=true
# Integration secrets are never stored in Supabase or sent to the browser.
# Create an integration connection with its matching auth_env_key, then set it here.
CARRIER_API_TOKEN=
ERP_API_TOKEN=
WMS_API_TOKEN=
